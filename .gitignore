.DS_Store
node_modules/

# Third-party sources cloned only to be read. Deliberately *none* of it is in the
# repository: it is raw material, deletable at any time, and the conclusions drawn
# from it have to live in our own words elsewhere — docs/research/, or an ADR.
#
# The whole folder, README included. A tracked file inside an otherwise untracked
# folder is a half-measure, and nothing durable lives here anyway.
#
# One hazard worth knowing BEFORE cloning one in — it was hit on the first read:
# these trees carry their own CLAUDE.md / AGENTS.md, and an agent auto-loads those
# by directory. Leave them and you are reading somebody else's instructions as if
# they were ours. Rename them after cloning:
#   find <clone>/ \( -name CLAUDE.md -o -name AGENTS.md \) -exec mv {} {}.upstream \;
references/

# The skill package is built from skills/skillmaster/ by scripts/build-skill-tgz.sh (v38), never
# tracked: a binary diff says nothing, and a committed copy is one more thing to forget to rebuild.
# `npm run build` in skillmaster-site/ produces it into public/ before vite copies public/ to dist/.
skillmaster-site/public/skill/skillmaster.tgz
skillmaster-site/public/skill/*.tmp

# Screenshots are a check's output, not source (2026-11-01, the user's call).
#
# `design/scripts/console-states.mjs` and `interaction-check.mjs` rewrite these every run
# — ~240 files, ~30MB, and a second machine with another Chrome or another font would
# render the same screen into different bytes. Same reasoning as `qa/role-matrix/output`,
# which was never tracked. Generate them when you need to look:
#   node design/scripts/console-states.mjs "design/skillmaster-控制台演示.html" design/shots/console --only <组>
design/shots/
