# 本地开发用的环境变量。`cp .env.example .env` 之后由 shell 导入：
#
#     set -a && source .env && set +a
#
# **线上的对应值不在这里。** 生产用到的凭据在仓库的 Secrets 里，其余配置在 Variables
# 里，由 `.github/workflows/server.yml` 的部署 job 渲染成服务器上的
# `/etc/skillmaster/server.env`。`.env` 只服务本机、不进 git（见 `.gitignore`）；
# 把线上的值抄进来会让两个来源同时存在，而它们迟早会不一致。
#
# 这里面的值全部只服务本机，绝不能用于任何部署环境。服务端在缺这些值时**启动失败**而不是
# 退化到默认值，是有意的：一个没人设过的静态令牌会表现成「客户端坏了」，而真正的原因是配置。

# 数据库。与 compose.yaml 里那个容器是同一对值。
SKILLMASTER_DB_USER=skillmaster
SKILLMASTER_DB_PASSWORD=skillmaster

# 这里曾经有一把静态令牌（SKILLMASTER_AUTH_STATIC_TOKEN）。它已经删掉了：
# /api/v1/* 现在只认授权服务器**签发**的令牌，配置里没有任何东西能换到访问权。
# 要一份凭据：跑 skmr login（浏览器那条路），或者在控制台签一把 key 放进
# SKILLMASTER_API_KEY。**无人值守只有第二条**——`client_credentials` 那条路在 v3 已经删掉
# （ADR 0038 §决定 9），留一条还写着那个 grant 的 oauth_client 行会让服务端起不来。

# 手机号的两把钥匙：HMAC 做盲索引、AES-GCM 做还原。各需 32 字节，启动时校验长度。
# 生产上这是两张随机字节（十六进制或 base64），不是口令——见 AesGcmPhoneCipher 的说明。
SKILLMASTER_PHONE_HMAC_KEY=0123456789abcdef0123456789abcdef
SKILLMASTER_PHONE_ENC_KEY=fedcba9876543210fedcba9876543210

# 把验证码写进日志，本地才读得到（真短信要凭据、签名与模板，见 iterations/0003）。
SKILLMASTER_SMS_LOG_CODES=true

# 不比对验证码：任意值都通过。签名与模板未过审时，用它把整条注册/找回流程先跑通
# （iterations/0011）。**默认关**，要用就取消下面这行的注释。
# 它摘掉的只有比对这一步：码仍要先请求、仍 5 分钟过期、仍只能用一次。
# 配了 SKILLMASTER_SMS_ACCESS_KEY_ID 还开着它，服务会**拒绝启动**。
# SKILLMASTER_SMS_ACCEPT_ANY_CODE=true

# ── 语义检索（v19, ADR 0095）──────────────────────────────────────────────────
# 百炼（DashScope）的 API key。**只有把下面的开关打开时才需要**：开着却没有 key，
# 服务会在启动时直接失败，而不是悄悄退回关键词。
#
# 打开它会做两件事：把已发布 skill 的 name / title / description / when_to_use 发给百炼，
# 并让发布依赖它——向量在发布事务里算，失败则整笔回滚。正文与文件从不发出。
DASHSCOPE_API_KEY=
SKILLMASTER_RETRIEVAL_ENABLED=false
# 可选：模型、维度、超时、阈值、过度取回。默认值见 application.yml，改维度是一次迁移。
# SKILLMASTER_RETRIEVAL_MODEL=text-embedding-v4
# SKILLMASTER_RETRIEVAL_DIMENSIONS=1024
# SKILLMASTER_RETRIEVAL_TIMEOUT=PT5S
# SKILLMASTER_RETRIEVAL_THRESHOLD=0.40
# SKILLMASTER_RETRIEVAL_OVER_FETCH=20

# ── CLI（本机）────────────────────────────────────────────────────────────────
# `skmr` 连哪个服务端。**留空就是连本地那套**（http://localhost:8080）——这是
# 二进制里 `config.DefaultServer` 的默认值，故意不指向生产：一条手滑的命令不该把凭据
# 递给一个真实的服务器。
#
# 线上地址不写在这里。发布构建从仓库变量 `SKILLMASTER_PUBLIC_BASE_URL` 注入，那个值和
# 服务端自己公布的 `issuer` 是同一个；把它抄进这个文件就是让同一个事实有两个出处。
#
# 要连别的环境时取消注释。这个变量只影响本机的 `skmr`，不影响服务端。
# SKILLMASTER_SERVER=http://localhost:8080
