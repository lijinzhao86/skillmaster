# 本地开发用的环境变量。`cp .env.example .env` 之后由 shell 导入：
#
#     set -a && source .env && set +a
#
# 这里面的值全部只服务本机，绝不能用于任何部署环境。服务端在缺这些值时**启动失败**而不是
# 退化到默认值，是有意的：一个没人设过的静态令牌会表现成「客户端坏了」，而真正的原因是配置。

# 数据库。与 compose.yaml 里那个容器是同一对值。
SKILLMASTER_DB_USER=skillmaster
SKILLMASTER_DB_PASSWORD=skillmaster

# P0 的那把静态令牌，以及它代表的用户。见 ADR 0004。
SKILLMASTER_AUTH_STATIC_TOKEN=dev-local-only-token-not-for-deployment

# 手机号的两把钥匙：HMAC 做盲索引、AES-GCM 做还原。各需 32 字节，启动时校验长度。
# 生产上这是两张随机字节（十六进制或 base64），不是口令——见 AesGcmPhoneCipher 的说明。
SKILLMASTER_PHONE_HMAC_KEY=0123456789abcdef0123456789abcdef
SKILLMASTER_PHONE_ENC_KEY=fedcba9876543210fedcba9876543210

# 把验证码写进日志，本地才读得到（真短信要凭据、签名与模板，见 iterations/0003）。
SKILLMASTER_SMS_LOG_CODES=true

# 不比对验证码：任意值都通过。签名与模板未过审时，用它把整条注册/找回流程先跑通
# （iterations/0011）。**默认关**，要用就取消下面这行的注释。
# 它摘掉的只有比对这一步：码仍要先请求、仍 5 分钟过期、仍只能用一次。
# 配了 SKILLMASTER_SMS_ACCESS_KEY_ID 还开着它，服务会**拒绝启动**。
# SKILLMASTER_SMS_ACCEPT_ANY_CODE=true
