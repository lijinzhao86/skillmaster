# Production environment for the server container.
#
# Copy to /etc/skillmaster/server.env, fill it in, chmod 0600. Nothing here belongs in
# the image, in compose.yaml, or in git - compose reads this file and nothing else.
#
# The server refuses to start when a value it needs is missing or malformed rather than
# falling back to a default (see application.yml and the properties tests): a
# deployment that starts and then behaves as if it were a laptop is the failure this
# file exists to prevent.

# --- Database ---------------------------------------------------------------
# The RDS instance's private endpoint. The ECS instance's address has to be in the
# instance's whitelist, otherwise the failure is a connection timeout with no clue.
SKILLMASTER_DB_URL=jdbc:postgresql://<rds-private-endpoint>:5432/skillmaster
SKILLMASTER_DB_USER=skillmaster
SKILLMASTER_DB_PASSWORD=

# --- Identity and cross-origin ----------------------------------------------
# The address a browser reaches the API at. It is the OAuth issuer and the base every
# absolute link the server prints is built from, so it must be the https name, not the
# container's.
SKILLMASTER_PUBLIC_BASE_URL=https://console.skillmasterai.com

# The session cookie widens to the registrable domain so www can present it for its one
# read-only session query (ADR 0086). No leading dot: Tomcat rejects it, and RFC 6265
# ignores it anyway. The CSRF cookie stays host-only on purpose.
SKILLMASTER_COOKIE_DOMAIN=skillmasterai.com

# The one origin allowed to read the session, and only on GET /web/session.
SKILLMASTER_SITE_ORIGIN=https://www.skillmasterai.com

# --- Phone numbers -----------------------------------------------------------
# Two independent 32-byte keys: one HMACs the blind index, the other decrypts the stored
# number. Generate each with `openssl rand -hex 32`. Losing the second one makes every
# stored number unreadable; changing the first one makes every login miss its account.
SKILLMASTER_PHONE_HMAC_KEY=
SKILLMASTER_PHONE_ENC_KEY=

# --- SMS ---------------------------------------------------------------------
# With an access key present, the signature and the template are required: Aliyun
# refuses every send without them, and a deployment that starts and then fails on every
# message is discovered by a user who never receives a code.
SKILLMASTER_SMS_ACCESS_KEY_ID=
SKILLMASTER_SMS_ACCESS_KEY_SECRET=
SKILLMASTER_SMS_SIGN_NAME=
SKILLMASTER_SMS_TEMPLATE_CODE=

# Never true in production. It stops the code from being compared at all, which means
# anyone can claim any phone number. The server refuses to start when it is set
# alongside credentials, but leaving it out is the only correct state here.
SKILLMASTER_SMS_LOG_CODES=false

# --- Service credentials (v52) -----------------------------------------------
# Where the root key for hosted credentials lives. `huawei` is the value this deployment
# uses (Huawei Cloud KMS, ADR 0172); `aliyun` is kept as the alternative and is the only
# other cloud value the server knows. Both seal the value in an envelope — a local
# AES-256 data key encrypts the value and only that 32-byte key goes to the KMS — so the
# root key never touches this file and the values are audited and rotated without a
# schema migration. `local` is a 32-byte key for a laptop and the test suite — the server
# refuses it on the `prod` profile (see below), and an empty `local` key is refused
# everywhere, so leaving this section blank breaks startup.
# Changing `sealer` after go-live needs every stored value re-sealed first: a blob records
# no provider, so values sealed under the old one cannot be opened by the new one.
SKILLMASTER_SECRET_SEALER=huawei
SKILLMASTER_SECRET_KMS_KEY_ID=
SKILLMASTER_SECRET_KMS_REGION=cn-east-3
# A dedicated identity that may call the KMS encrypt/decrypt operations on that CMK and
# nothing else. Required with `huawei`: the host is an Aliyun ECS, so Huawei's default
# credential chain has nothing to read. With `aliyun` it may stay blank (the host's RAM
# role is then used). Giving only one half is refused.
SKILLMASTER_SECRET_ACCESS_KEY_ID=
SKILLMASTER_SECRET_ACCESS_KEY_SECRET=

# --- Deployment profile ------------------------------------------------------
# `prod` is what makes the refusals above real: without it the server would accept a
# `local` sealer here. Nothing else reads the profile.
SPRING_PROFILES_ACTIVE=prod
