# Copy to .env and fill in. `.env` is gitignored; this example is the shape.
#
# Six accounts, one per rung. Usernames and phones must be distinct; the password may be shared.
# `seed` signs each one in and registers it only when signing in says it does not exist.
# 下面写的密码是**占位符**，复制成 .env 后换成你自己的；账号已经存在时就按 .env 里这个密码登录。

# The web plane. The Vite dev server proxies /api/v1, /web and /oauth to the server on 8080.
ROLE_MATRIX_SERVER=http://localhost:5173

# The skill every rung is measured against: one version in each state the console draws.
ROLE_MATRIX_SKILL=matrix-owner/role-matrix-fixture
# The disposable one the lifecycle probes take offline, revoke and restore.
ROLE_MATRIX_SCRATCH=matrix-owner/role-matrix-scratch

# Used only by `seed`, to solve the registration captcha from the dev database.
# Must point at this machine — seed refuses anything else (see role_matrix/captcha.py).
ROLE_MATRIX_DB_URL=postgresql://skillmaster:skillmaster@localhost:5432/skillmaster

ROLE_MATRIX_OWNER_USERNAME=matrix-owner
ROLE_MATRIX_OWNER_PHONE=13900000010
ROLE_MATRIX_OWNER_PASSWORD=change-me-role-matrix

ROLE_MATRIX_INVOKE_USERNAME=role-invoke
ROLE_MATRIX_INVOKE_PHONE=13900000011
ROLE_MATRIX_INVOKE_PASSWORD=change-me-role-matrix

ROLE_MATRIX_BROWSE_USERNAME=role-browse
ROLE_MATRIX_BROWSE_PHONE=13900000012
ROLE_MATRIX_BROWSE_PASSWORD=change-me-role-matrix

ROLE_MATRIX_WRITE_USERNAME=role-write
ROLE_MATRIX_WRITE_PHONE=13900000013
ROLE_MATRIX_WRITE_PASSWORD=change-me-role-matrix

ROLE_MATRIX_MAINTAIN_USERNAME=role-maintain
ROLE_MATRIX_MAINTAIN_PHONE=13900000014
ROLE_MATRIX_MAINTAIN_PASSWORD=change-me-role-matrix

ROLE_MATRIX_ADMIN_USERNAME=role-admin
ROLE_MATRIX_ADMIN_PHONE=13900000015
ROLE_MATRIX_ADMIN_PASSWORD=change-me-role-matrix

ROLE_MATRIX_BYSTANDER_USERNAME=role-bystander
ROLE_MATRIX_BYSTANDER_PHONE=13900000016
ROLE_MATRIX_BYSTANDER_PASSWORD=change-me-role-matrix
