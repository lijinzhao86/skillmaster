<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.skillmasterai</groupId>
	<artifactId>skillmaster-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>skillmaster-server</name>
	<description>API and authorization server for skillmaster</description>
	<properties>
		<java.version>25</java.version>
		<!-- Not managed by spring-boot-dependencies, so both are pinned here. -->
		<commons-compress.version>1.28.0</commons-compress.version>
		<archunit.version>1.5.1</archunit.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- BCryptPasswordEncoder, which is a compile-time type in M1. Declared rather than
		     borrowed through spring-boot-starter-security's transitive edge: a type we compile
		     against should be a dependency we asked for. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!-- The /web plane's session store. Sessions live in PostgreSQL like every other piece of
		     state (ADR 0010); this replaces a hand-rolled browser_session table, whose expiry,
		     rotation and concurrency control would otherwise all be ours to get right.

		     Carries a script initializer that creates Spring Session's schema on startup. Our own
		     migration creates it instead, so `spring.session.jdbc.initialize-schema: never` must be
		     set wherever this dependency is — the initializer is armed by the dependency alone. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>
		<!-- The captcha image. Used for rendering only: the answer is drawn from a SecureRandom we
		     supply, because the library's own generator uses `RandomUtil.getRandom()`, which is
		     ThreadLocalRandom — predictable from a handful of samples, which would make the captcha
		     decorative. See HutoolCaptchaRenderer.

		     Its own weight is 19 KB and the only thing it brings is hutool-core. -->
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-captcha</artifactId>
			<version>5.8.47</version>
		</dependency>
		<!-- Aliyun's SMS API. The official SDK rather than the documented RPC signature by hand:
		     the signing, clock skew, retries and endpoint resolution are all things it has already
		     got right, and getting them subtly wrong is discovered by a user who never receives a
		     code. The cost is real and was measured: it drags in okhttp, gson and kotlin-stdlib —
		     so there is a second JSON stack on this classpath. It is confined to config.SmsConfig;
		     no module imports it. -->
		<dependency>
			<groupId>com.aliyun</groupId>
			<artifactId>dysmsapi20170525</artifactId>
			<version>4.6.0</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Boot 4 moved autoconfiguration out of spring-boot-autoconfigure into one artifact
		     per technology, so without this the Flyway beans are never created and migrations
		     silently never run — the migrations would exist and do nothing. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!-- Frontmatter is YAML and must be parsed strictly: a hand-written parser is
		     what silently mangled nested metadata and block scalars in the archived
		     baseline (see known-issues.md M5). Declared explicitly rather than borrowed
		     transitively from Boot's config loading. -->
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
		</dependency>
		<!-- Needed for zip entries' unix mode, which is the only way to tell a symlink
		     entry from a regular file — java.util.zip does not expose it. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-compress</artifactId>
			<version>${commons-compress.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- The gateway skill's source lives at the repository root, not in this subproject,
			     because two subprojects need it: the server publishes it into the reserved
			     namespace, and the CLI installs it locally. Copying it onto the classpath here
			     rather than committing a second copy is the point — §2.3 of the docs conventions
			     allows one authoritative location per fact, and a duplicated SKILL.md would drift
			     from the one the CLI ships.

			     From `../gateway` into `gateway/` in the output, so the resource path is
			     `gateway/skillmaster/SKILL.md` — the same relative path it has in the repository,
			     which is what keeps the substitution step honest about what it is reading. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-gateway-skill</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/gateway</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../gateway</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Integration tests (*IT) hit a real PostgreSQL, so they run at `verify`,
			     after surefire's pure unit tests. The parent already binds the
			     integration-test and verify goals, so declaring the plugin is enough. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
